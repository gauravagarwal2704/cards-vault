<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:padding="4dp" android:background="@drawable/widget_surface">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent"
        android:layout_height="32dp" android:gravity="center_vertical">
      <ImageView android:id="@+id/widget_app_logo" android:layout_width="16dp"
          android:layout_height="16dp" android:layout_marginEnd="3dp"
          android:src="@mipmap/ic_launcher_three_d" android:scaleType="fitCenter"
          android:importantForAccessibility="no" />
      <TextView android:id="@+id/widget_title" android:layout_width="0dp"
          android:layout_weight="1" android:layout_height="wrap_content"
          android:text="Card Vault" android:textSize="10sp" android:textStyle="bold"
          android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" />
      <TextView android:id="@+id/widget_settings" android:layout_width="28dp"
          android:layout_height="32dp" android:text="Edit" android:gravity="center"
          android:textSize="10sp" android:textColor="#CCDFFF"
          android:contentDescription="Customize widget cards" />
    </LinearLayout>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Choose cards"
        android:gravity="center" android:textSize="11sp" android:textColor="#FFFFFF" />
    <LinearLayout android:id="@+id/widget_cards" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:gravity="center">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:orientation="horizontal">
        <ImageView android:id="@+id/widget_card_0" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="2dp" android:scaleType="fitCenter"
            android:contentDescription="Card preview" />
        <ImageView android:id="@+id/widget_card_1" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="2dp" android:scaleType="fitCenter"
            android:contentDescription="Card preview" />
      </LinearLayout>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:orientation="horizontal">
        <ImageView android:id="@+id/widget_card_2" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="2dp" android:scaleType="fitCenter"
            android:contentDescription="Card preview" />
        <ImageView android:id="@+id/widget_card_3" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="2dp" android:scaleType="fitCenter"
            android:contentDescription="Card preview" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
