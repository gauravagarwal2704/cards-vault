<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="6dp" android:background="@drawable/widget_surface">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_app_logo" android:layout_width="20dp" android:layout_height="20dp"
            android:layout_marginStart="2dp" android:layout_marginEnd="4dp" android:src="@mipmap/ic_launcher_burgundy"
            android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Card Vault" android:textSize="11sp" android:textStyle="bold"
            android:gravity="center_vertical" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_settings" android:layout_width="32dp" android:layout_height="48dp"
            android:text="Edit" android:gravity="center" android:textSize="12sp" android:textColor="#CCDFFF"
            android:contentDescription="Customize widget cards" />
    </LinearLayout>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Choose cards" android:gravity="center" android:textSize="14sp" android:textColor="#FFFFFF" />
    <LinearLayout android:gravity="top|center_horizontal" android:id="@+id/widget_cards" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"><ImageView android:id="@+id/widget_card_0" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:scaleType="fitCenter"
            android:contentDescription="Card preview" /><ImageView android:id="@+id/widget_card_1" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:scaleType="fitCenter"
            android:contentDescription="Card preview" /><ImageView android:id="@+id/widget_card_2" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:scaleType="fitCenter"
            android:contentDescription="Card preview" /><ImageView android:id="@+id/widget_card_3" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:scaleType="fitCenter"
            android:contentDescription="Card preview" /></LinearLayout>
</LinearLayout>
</FrameLayout>
